# Terramate project configuration of Gaean Key.
#
# The stacks under stacks/ are written by scripts/sync_stacks.py from configurations/ and the
# OpenTofu code inside them is generated by `terramate generate` from stacks/engine.tm.hcl.
# See docs/terramate.md.

terramate {
  required_version = ">= 0.17.0"

  config {
    # Credentials flow between stacks through Terramate outputs sharing
    # (`output` blocks in producer stacks, `input` blocks in consumer stacks).
    experiments = ["outputs-sharing"]

    git {
      default_branch = "master"
    }
  }
}

# Outputs sharing reads the producer outputs with `tofu output -json` and hands them to the
# consumers as TF_VAR_* variables, so run with `terramate run --enable-sharing -- tofu ...`.
sharing_backend "gaean" {
  type     = terraform
  filename = "_gaean_sharing.tf"
  command  = ["tofu", "output", "-json"]
}
